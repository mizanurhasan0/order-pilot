# Port the HTTP server listens on
PORT=3000
# Secret string you also enter as the Verify Token in the Meta app's webhook settings
META_VERIFY_TOKEN=replace_with_secure_random_token
# App Secret from Meta App Dashboard > App settings > Basic (used to validate X-Hub-Signature-256)
META_APP_SECRET=replace_with_meta_app_secret
# Page access token used by the Send API
PAGE_ACCESS_TOKEN=replace_with_page_access_token
# Numeric Page ID, also visible as pageId in the webhook logs
FACEBOOK_PAGE_ID=replace_with_page_id
# Graph API version, v26.0 is current
META_GRAPH_API_VERSION=v26.0
# true sends automatic replies, false keeps receive-and-log only (other values are rejected)
ENABLE_AUTO_REPLY=true
# The bot reads a new customer's Facebook language once: English locales get English, everyone
# else Bangla. On unless this is false (then everyone starts in Bangla). Customers can switch with
# the 🌐 button either way.
DETECT_LANGUAGE=true
# Protects /api/orders (customer phone numbers and addresses). Sent as the X-Admin-Key header. Generate with: openssl rand -hex 24
ADMIN_API_KEY=replace_with_secure_random_key
# Upstash Redis REST URL and token. Required on Vercel (orders and chat sessions must be shared
# by every serverless instance); optional locally, where memory is used when both are empty.
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

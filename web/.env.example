# Copy to .env.local. BACKEND_API_URL and ADMIN_API_KEY are read only by proxy.ts on
# the Next.js server and never reach the browser, so never prefix them with NEXT_PUBLIC_.

# Base URL of the Express API (plain http or https, no credentials or query string).
# On Vercel: the backend's production URL, e.g. https://orderpilot-api.vercel.app
BACKEND_API_URL=http://127.0.0.1:3000

# Must equal ADMIN_API_KEY in the Express backend's .env. proxy.ts adds it as the
# X-Admin-Key header on /api/orders requests only.
ADMIN_API_KEY=put_the_exact_backend_admin_api_key_here

# Public, not a secret: your Facebook Page's username (the part after facebook.com/).
# The Products screen builds product links from it: https://m.me/<username>?ref=ORDER_PRODUCT:P001
# Inlined at build time, so restart pnpm dev (or redeploy on Vercel) after changing it.
NEXT_PUBLIC_FACEBOOK_PAGE_USERNAME=
